# Copie para scripts/.env e preencha as credenciais e IDs do seu ambiente.
# Variáveis de ambiente prevalecem sobre este arquivo. Não versione scripts/.env.
SCADA_URL=http://localhost:8080
SCADA_EMAIL=
# Vazia: senha solicitada no terminal com entrada protegida.
SCADA_SENHA=

# Preencha cada par ativo/fonte em conjunto; confira os IDs reais nas APIs.
# Linha é opcional. A demonstração US23 exige transformador e fonte SIMULADA.
LINHA_ID=
FONTE_LINHA_ID=
TRANSFORMADOR_ID=
FONTE_TRANSFORMADOR_ID=

# Defaults do simulador; intervalos e contagens são inteiros positivos.
SEMENTE=42
CADENCIA_SEGUNDOS=30
INTERVALO_DEMO_SEGUNDOS=5
LEITURAS_DEMO=3
TIMEOUT_COMUNICACAO_SEGUNDOS=300
PAUSA_SEGUNDOS=305
ESPERA_ALERTA_SEGUNDOS=90
TENTATIVAS=3

# manual: chama POST /api/jobs/avaliar-comunicacao.
# agendada: exige scheduler habilitado em uma única instância do backend.
# Alinhe o timeout com o backend; PAUSA_SEGUNDOS deve ser maior que ele.
AVALIACAO_COMUNICACAO=manual
